From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: 3x-ui TgWeb patchset
Date: Tue, 6 Oct 2026 00:00:00 +0300
Subject: [PATCH 1/3] core: add TgWeb protocol with hard Xray isolation

Baseline: MHSanaei/3x-ui@6be3c438e1420f24dd10060f8a1dd620b2d0e73b

This patch intentionally does not add the runtime manager yet. It establishes
the safety boundary first:
- tgweb is a recognized inbound protocol;
- port 0 remains valid (already supported by the model);
- tgweb is never emitted into Xray config;
- frontend sniffing controls are hidden for tgweb;
- a regression test asserts that TgWeb-only metadata cannot leak to Xray.

diff --git a/internal/database/model/model.go b/internal/database/model/model.go
--- a/internal/database/model/model.go
+++ b/internal/database/model/model.go
@@ -31,7 +31,8 @@ const (
 	Mixed       Protocol = "mixed"
 	WireGuard   Protocol = "wireguard"
 	Hysteria    Protocol = "hysteria"
 	MTProto     Protocol = "mtproto"
 	AmneziaWG   Protocol = "amneziawg"
 	TUIC        Protocol = "tuic"
+	TgWeb       Protocol = "tgweb"
 )
@@ -64,7 +65,7 @@ type Inbound struct {
 	// Xray configuration fields
 	Listen            string   `json:"listen" form:"listen"`
 	Port              int      `json:"port" form:"port" validate:"gte=0,lte=65535" example:"443"`
-	Protocol          Protocol `json:"protocol" form:"protocol" validate:"required,oneof=vmess vless trojan shadowsocks wireguard hysteria http mixed tunnel tun mtproto amneziawg tuic" example:"vless"`
+	Protocol          Protocol `json:"protocol" form:"protocol" validate:"required,oneof=vmess vless trojan shadowsocks wireguard hysteria http mixed tunnel tun mtproto amneziawg tuic tgweb" example:"vless"`
 	Settings          string   `json:"settings" form:"settings"`
 	StreamSettings    string   `json:"streamSettings" form:"streamSettings"`
 	Tag               string   `json:"tag" form:"tag" gorm:"unique" example:"in-443-tcp"`

diff --git a/internal/web/service/xray.go b/internal/web/service/xray.go
--- a/internal/web/service/xray.go
+++ b/internal/web/service/xray.go
@@ -203,7 +203,10 @@ func (s *XrayService) GetXrayConfig() (*xray.Config, error) {
 		if inbound.NodeID != nil {
 			continue
 		}
-		if inbound.Protocol == model.MTProto || inbound.Protocol == model.AmneziaWG || inbound.Protocol == model.TUIC {
+		if inbound.Protocol == model.MTProto ||
+			inbound.Protocol == model.AmneziaWG ||
+			inbound.Protocol == model.TUIC ||
+			inbound.Protocol == model.TgWeb {
 			continue
 		}
 		settings := map[string]any{}

diff --git a/frontend/src/lib/xray/protocol-capabilities.ts b/frontend/src/lib/xray/protocol-capabilities.ts
--- a/frontend/src/lib/xray/protocol-capabilities.ts
+++ b/frontend/src/lib/xray/protocol-capabilities.ts
@@ -75,12 +75,14 @@ export function canEnableStream(values: { protocol: string }): boolean {
   return STREAM_PROTOCOLS.includes(values.protocol);
 }
 
-// mtproto and amneziawg are served by an external process/interface, not
-// Xray, so the Xray sniffing block does not apply to either. Every other
-// inbound supports sniffing.
+// These protocols are served outside Xray, so the Xray sniffing block does
+// not apply to them.
 export function canEnableSniffing(values: { protocol: string }): boolean {
   return (
-    values.protocol !== 'mtproto' && values.protocol !== 'amneziawg' && values.protocol !== 'tuic'
+    values.protocol !== 'mtproto' &&
+    values.protocol !== 'amneziawg' &&
+    values.protocol !== 'tuic' &&
+    values.protocol !== 'tgweb'
   );
 }
 
diff --git a/internal/web/service/xray_tgweb_test.go b/internal/web/service/xray_tgweb_test.go
new file mode 100644
--- /dev/null
+++ b/internal/web/service/xray_tgweb_test.go
@@ -0,0 +1,45 @@
+package service
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+)
+
+func TestGetXrayConfigSkipsTgWebInbound(t *testing.T) {
+	setupConflictDB(t)
+
+	seedInboundConflict(
+		t,
+		"tgweb-safety-probe",
+		"",
+		0,
+		model.TgWeb,
+		"",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[{"email":"mv","enable":true,"secret":"tgweb-secret-probe"}]}`,
+	)
+
+	cfg, err := (&XrayService{}).GetXrayConfig()
+	if err != nil {
+		t.Fatalf("GetXrayConfig: %v", err)
+	}
+
+	raw, err := json.Marshal(cfg)
+	if err != nil {
+		t.Fatalf("marshal Xray config: %v", err)
+	}
+	got := string(raw)
+
+	for _, forbidden := range []string{
+		"tgweb",
+		"web.maicraft.tech",
+		"tgweb-secret-probe",
+		"tgweb-safety-probe",
+	} {
+		if strings.Contains(got, forbidden) {
+			t.Fatalf("TgWeb data leaked into Xray config: found %q in %s", forbidden, got)
+		}
+	}
+}
