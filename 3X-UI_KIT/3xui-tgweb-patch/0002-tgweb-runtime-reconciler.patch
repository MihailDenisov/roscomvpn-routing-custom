diff --git a/internal/web/service/inbound_tgweb_client_test.go b/internal/web/service/inbound_tgweb_client_test.go
new file mode 100644
--- /dev/null
+++ b/internal/web/service/inbound_tgweb_client_test.go
@@ -0,0 +1,87 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+)
+
+func TestAddTgWebClientNeedsNoXrayCredentialOrRestart(t *testing.T) {
+	setupConflictDB(t)
+	seedInboundConflict(
+		t,
+		"tgweb-clients",
+		"",
+		0,
+		model.TgWeb,
+		"",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`,
+	)
+	ib := loadInboundByTag(t, "tgweb-clients")
+
+	svc := &ClientService{}
+	needRestart, err := svc.AddInboundClient(&InboundService{}, &model.Inbound{
+		Id: ib.Id,
+		Settings: clientsSettings(t, []model.Client{{
+			Email:  "mv",
+			SubID:  "mv-tgweb-sub",
+			Enable: true,
+		}}),
+	})
+	if err != nil {
+		t.Fatalf("AddInboundClient: %v", err)
+	}
+	if needRestart {
+		t.Fatal("TgWeb attach must not request an Xray restart")
+	}
+
+	var rec model.ClientRecord
+	if err := database.GetDB().Where("email = ?", "mv").First(&rec).Error; err != nil {
+		t.Fatalf("client record: %v", err)
+	}
+	if rec.UUID != "" || rec.Password != "" || rec.Auth != "" || rec.Secret != "" {
+		t.Fatalf("TgWeb minted an Xray/runtime credential in clients table: %+v", rec)
+	}
+	var n int64
+	if err := database.GetDB().Model(&model.ClientInbound{}).
+		Where("client_id = ? AND inbound_id = ?", rec.Id, ib.Id).Count(&n).Error; err != nil {
+		t.Fatalf("client_inbounds: %v", err)
+	}
+	if n != 1 {
+		t.Fatalf("client_inbounds count = %d, want 1", n)
+	}
+}
+func TestCreateTgWebOnlyClientDropsGenericCredentials(t *testing.T) {
+	setupConflictDB(t)
+	seedInboundConflict(
+		t,
+		"tgweb-create",
+		"",
+		0,
+		model.TgWeb,
+		"",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`,
+	)
+	ib := loadInboundByTag(t, "tgweb-create")
+
+	svc := &ClientService{}
+	_, err := svc.Create(&InboundService{}, &ClientCreatePayload{
+		Client: model.Client{
+			Email: "tgweb-only", SubID: "tgweb-only-sub", Enable: true,
+			ID: "frontend-generated-uuid", Password: "frontend-password",
+			Auth: "frontend-auth", Secret: "frontend-secret",
+		},
+		InboundIds: []int{ib.Id},
+	})
+	if err != nil {
+		t.Fatalf("Create: %v", err)
+	}
+	var rec model.ClientRecord
+	if err := database.GetDB().Where("email = ?", "tgweb-only").First(&rec).Error; err != nil {
+		t.Fatalf("client record: %v", err)
+	}
+	if rec.UUID != "" || rec.Password != "" || rec.Auth != "" || rec.Secret != "" {
+		t.Fatalf("TgWeb-only create persisted generic credentials: %+v", rec)
+	}
+}

diff --git a/internal/tgweb/manager_test.go b/internal/tgweb/manager_test.go
new file mode 100644
--- /dev/null
+++ b/internal/tgweb/manager_test.go
@@ -0,0 +1,140 @@
+package tgweb
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type fakeAPI struct {
+	snapshot []SnapshotDomain
+	puts     map[string][]PolicyClient
+	getErr   error
+}
+
+func (f *fakeAPI) Get(context.Context) ([]SnapshotDomain, error) {
+	if f.getErr != nil {
+		return nil, f.getErr
+	}
+	return f.snapshot, nil
+}
+
+func (f *fakeAPI) Put(_ context.Context, domain string, clients []PolicyClient) error {
+	if f.puts == nil {
+		f.puts = map[string][]PolicyClient{}
+	}
+	f.puts[domain] = append([]PolicyClient(nil), clients...)
+	return nil
+}
+
+func byName(clients []PolicyClient, name string) (PolicyClient, bool) {
+	for _, c := range clients {
+		if c.Name == name {
+			return c, true
+		}
+	}
+	return PolicyClient{}, false
+}
+
+func TestReconcilePreservesSecretAndDisablesDetached(t *testing.T) {
+	api := &fakeAPI{snapshot: []SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []SnapshotClient{
+			{PolicyClient: PolicyClient{Name: "mv", Secret: "00112233445566778899aabbccddeeff", Enabled: true}, BytesUp: 3, BytesDown: 4},
+			{PolicyClient: PolicyClient{Name: "old", Secret: "ffeeddccbbaa99887766554433221100", Enabled: true}},
+		},
+	}}}
+	m := NewManager(api)
+	err := m.Reconcile(context.Background(), []DesiredDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []DesiredClient{{
+			Name: "mv", Enabled: true, TotalBytes: 1000, VPNUsedBytes: 100,
+		}},
+	}})
+	if err != nil {
+		t.Fatalf("Reconcile: %v", err)
+	}
+	put := api.puts["web.maicraft.tech"]
+	mv, ok := byName(put, "mv")
+	if !ok {
+		t.Fatal("mv missing from PUT")
+	}
+	if mv.Secret != "00112233445566778899aabbccddeeff" {
+		t.Fatalf("secret rotated: %q", mv.Secret)
+	}
+	if !mv.Enabled || mv.QuotaBytes != 900 {
+		t.Fatalf("mv policy = %+v", mv)
+	}
+	old, ok := byName(put, "old")
+	if !ok || old.Enabled {
+		t.Fatalf("detached credential must be retained disabled: %+v", old)
+	}
+}
+
+func TestReconcileSharedQuotaIncludesCurrentWebUsage(t *testing.T) {
+	api := &fakeAPI{snapshot: []SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []SnapshotClient{{
+			PolicyClient: PolicyClient{Name: "mv", Secret: "00112233445566778899aabbccddeeff", Enabled: true},
+			BytesUp: 30, BytesDown: 20,
+		}},
+	}}}
+	m := NewManager(api)
+	err := m.Reconcile(context.Background(), []DesiredDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []DesiredClient{{
+			Name: "mv", Enabled: true, TotalBytes: 100, VPNUsedBytes: 50,
+		}},
+	}})
+	if err != nil {
+		t.Fatalf("Reconcile: %v", err)
+	}
+	mv, _ := byName(api.puts["web.maicraft.tech"], "mv")
+	if mv.Enabled {
+		t.Fatal("client stayed enabled after VPN+WEB exhausted shared quota")
+	}
+}
+
+func TestReconcileHonorsExpiry(t *testing.T) {
+	api := &fakeAPI{}
+	m := NewManager(api)
+	err := m.Reconcile(context.Background(), []DesiredDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []DesiredClient{{
+			Name: "mv", Enabled: true, ExpiryTimeMS: time.Now().Add(-time.Minute).UnixMilli(),
+		}},
+	}})
+	if err != nil {
+		t.Fatalf("Reconcile: %v", err)
+	}
+	mv, _ := byName(api.puts["web.maicraft.tech"], "mv")
+	if mv.Enabled {
+		t.Fatal("expired client stayed enabled")
+	}
+}
+
+func TestReconcileDisablesRuntimeClientsWhenNoInboundRemains(t *testing.T) {
+	api := &fakeAPI{snapshot: []SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []SnapshotClient{{
+			PolicyClient: PolicyClient{Name: "mv", Secret: "00112233445566778899aabbccddeeff", Enabled: true},
+		}},
+	}}}
+	m := NewManager(api)
+	if err := m.Reconcile(context.Background(), nil); err != nil {
+		t.Fatalf("Reconcile: %v", err)
+	}
+	mv, ok := byName(api.puts["web.maicraft.tech"], "mv")
+	if !ok || mv.Enabled {
+		t.Fatalf("orphaned runtime credential must be disabled: %+v", mv)
+	}
+}
+
+func TestReconcileRuntimeFailureIsReturnedForRetry(t *testing.T) {
+	want := errors.New("runtime down")
+	m := NewManager(&fakeAPI{getErr: want})
+	if err := m.Reconcile(context.Background(), []DesiredDomain{{Domain: "web.maicraft.tech"}}); !errors.Is(err, want) {
+		t.Fatalf("Reconcile error = %v, want %v", err, want)
+	}
+}
