+package tgweb
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type fakeAPI struct {
+	snapshot []SnapshotDomain
+	puts     map[string][]PolicyClient
+	getErr   error
+}
+
+func (f *fakeAPI) Get(context.Context) ([]SnapshotDomain, error) {
+	if f.getErr != nil {
+		return nil, f.getErr
+	}
+	return f.snapshot, nil
+}
+
+func (f *fakeAPI) Put(_ context.Context, domain string, clients []PolicyClient) error {
+	if f.puts == nil {
+		f.puts = map[string][]PolicyClient{}
+	}
+	f.puts[domain] = append([]PolicyClient(nil), clients...)
+	return nil
+}
+
+func byName(clients []PolicyClient, name string) (PolicyClient, bool) {
+	for _, c := range clients {
+		if c.Name == name {
+			return c, true
+		}
+	}
+	return PolicyClient{}, false
+}
+
+func TestReconcilePreservesSecretAndDisablesDetached(t *testing.T) {
+	api := &fakeAPI{snapshot: []SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []SnapshotClient{
+			{PolicyClient: PolicyClient{Name: "mv", Secret: "00112233445566778899aabbccddeeff", Enabled: true}, BytesUp: 3, BytesDown: 4},
+			{PolicyClient: PolicyClient{Name: "old", Secret: "ffeeddccbbaa99887766554433221100", Enabled: true}},
+		},
+	}}}
+	m := NewManager(api)
+	err := m.Reconcile(context.Background(), []DesiredDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []DesiredClient{{
+			Name: "mv", Enabled: true, TotalBytes: 1000, VPNUsedBytes: 100,
+		}},
+	}})
+	if err != nil {
+		t.Fatalf("Reconcile: %v", err)
+	}
+	put := api.puts["web.maicraft.tech"]
+	mv, ok := byName(put, "mv")
+	if !ok {
+		t.Fatal("mv missing from PUT")
+	}
+	if mv.Secret != "00112233445566778899aabbccddeeff" {
+		t.Fatalf("secret rotated: %q", mv.Secret)
+	}
+	if !mv.Enabled || mv.QuotaBytes != 900 {
+		t.Fatalf("mv policy = %+v", mv)
+	}
+	old, ok := byName(put, "old")
+	if !ok || old.Enabled {
+		t.Fatalf("detached credential must be retained disabled: %+v", old)
+	}
+}
