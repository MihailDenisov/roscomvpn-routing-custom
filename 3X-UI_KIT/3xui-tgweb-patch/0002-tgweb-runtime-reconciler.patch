+// TestBulkDisableTgWebOnlyClient covers DEFECT-C (disable half) for a client
+// attached ONLY to tgweb: BulkSetEnable(false) must persist clients.enable
+// and must not report "Client Not Found In Inbound".
+func TestBulkDisableTgWebOnlyClient(t *testing.T) {
+	setupBulkDB(t)
+	svc := &ClientService{}
+	inboundSvc := &InboundService{}
+	email := "tgweb-only-disable@x"
+	tgwebIB := seedTgWebInbound(t, 54103)
+
+	if _, err := svc.Create(inboundSvc, &ClientCreatePayload{
+		Client:     model.Client{Email: email, SubID: email + "-sub", Enable: true},
+		InboundIds: []int{tgwebIB.Id},
+	}); err != nil {
+		t.Fatalf("create tgweb-only client: %v", err)
+	}
+
+	result, needRestart, err := svc.BulkSetEnable(inboundSvc, []string{email}, false)
+	if err != nil {
+		t.Fatalf("BulkSetEnable(false) (DEFECT-C regression): %v", err)
+	}
+	if needRestart {
+		t.Fatal("tgweb bulk disable must not request an Xray restart")
+	}
+	if result.Changed != 1 {
+		t.Fatalf("Changed = %d, want 1 (skipped: %+v)", result.Changed, result.Skipped)
+	}
+	for _, sk := range result.Skipped {
+		if strings.Contains(sk.Reason, "Not Found") {
+			t.Fatalf("tgweb-only client skipped: %+v", sk)
+		}
+	}
+	if got := recordEnableOf(t, svc, email); got {
+		t.Fatal("clients.enable = true, want false")
+	}
+}
