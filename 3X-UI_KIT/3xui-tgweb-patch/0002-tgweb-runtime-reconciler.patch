+func TestReconcileSharedQuotaIncludesCurrentWebUsage(t *testing.T) {
+	api := &fakeAPI{snapshot: []SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []SnapshotClient{{
+			PolicyClient: PolicyClient{Name: "mv", Secret: "00112233445566778899aabbccddeeff", Enabled: true},
+			BytesUp: 30, BytesDown: 20,
+		}},
+	}}}
+	m := NewManager(api)
+	err := m.Reconcile(context.Background(), []DesiredDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []DesiredClient{{
+			Name: "mv", Enabled: true, TotalBytes: 100, VPNUsedBytes: 50,
+		}},
+	}})
+	if err != nil {
+		t.Fatalf("Reconcile: %v", err)
+	}
+	mv, _ := byName(api.puts["web.maicraft.tech"], "mv")
+	if mv.Enabled {
+		t.Fatal("client stayed enabled after VPN+WEB exhausted shared quota")
+	}
+}
