+import { Alert, Input, InputNumber } from 'antd';
+
+import { FormField } from '@/components/form/rhf';
+
+export default function TgwebFields() {
+  return (
+    <>
+      <Alert
+        type="info"
+        showIcon
+        message="External Telegram WebProxy"
+        description="Published via SNI routing. This inbound does not create an Xray listener."
+      />
+      <FormField
+        name={['settings', 'publicHost']}
+        label="Public host"
+        tooltip="Hostname advertised to Telegram clients and routed by the external SNI edge."
+      >
+        <Input placeholder="web.maicraft.tech" />
+      </FormField>
+      <FormField
+        name={['settings', 'publicPort']}
+        label="Public port"
+        tooltip="Public HTTPS port advertised to Telegram clients. The local TgWeb backend remains private."
+      >
+        <InputNumber min={1} max={65535} style={{ width: '100%' }} />
+      </FormField>
+    </>
+  );
+}
+
