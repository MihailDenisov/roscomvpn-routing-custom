@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest';
+
+import { createDefaultInboundSettings } from '@/lib/xray/inbound-defaults';
+import { canEnableSniffing, canEnableStream } from '@/lib/xray/protocol-capabilities';
+import { InboundSettingsSchema } from '@/schemas/protocols/inbound';
+import { ProtocolSchema } from '@/schemas/primitives/protocol';
+
+describe('tgweb inbound', () => {
+  it('is a recognized protocol with external defaults', () => {
+    expect(ProtocolSchema.parse('tgweb')).toBe('tgweb');
+    expect(createDefaultInboundSettings('tgweb')).toEqual({
+      publicHost: 'web.maicraft.tech',
+      publicPort: 443,
+      clients: [],
+    });
+  });
+
+  it('parses its settings branch', () => {
+    expect(
+      InboundSettingsSchema.parse({
+        protocol: 'tgweb',
+        settings: {
+          publicHost: 'web.maicraft.tech',
+          publicPort: 443,
+          clients: [],
+        },
+      }),
+    ).toMatchObject({
+      protocol: 'tgweb',
+      settings: { publicHost: 'web.maicraft.tech', publicPort: 443 },
+    });
+  });
+
+  it('has no Xray stream or sniffing controls', () => {
+    expect(canEnableStream({ protocol: 'tgweb' })).toBe(false);
+    expect(canEnableSniffing({ protocol: 'tgweb' })).toBe(false);
+  });
+});
