+++ b/frontend/src/schemas/protocols/inbound/tgweb.ts
@@ -0,0 +1,22 @@
+import { z } from 'zod';
+
+export const TgwebClientSchema = z
+  .object({
+    email: z.string().min(1),
+    subId: z.string().default(''),
+    enable: z.boolean().default(true),
+    totalGB: z.number().int().min(0).default(0),
+    expiryTime: z.number().int().default(0),
+    limitIp: z.number().int().min(0).default(0),
+    comment: z.string().default(''),
+  })
+  .passthrough();
+
+export const TgwebInboundSettingsSchema = z.object({
+  publicHost: z.string().trim().min(1).default('web.maicraft.tech'),
+  publicPort: z.number().int().min(1).max(65535).default(443),
+  clients: z.array(TgwebClientSchema).default([]),
+});
+
+export type TgwebClient = z.infer<typeof TgwebClientSchema>;
+export type TgwebInboundSettings = z.infer<typeof TgwebInboundSettingsSchema>;
