+	setupBulkDB(t)
+	svc := &ClientService{}
+	inboundSvc := &InboundService{}
+	email := "tgweb-only-enable@x"
+	tgwebIB := seedTgWebInbound(t, 54104)
+
+	if _, err := svc.Create(inboundSvc, &ClientCreatePayload{
+		Client:     model.Client{Email: email, SubID: email + "-sub", Enable: false},
+		InboundIds: []int{tgwebIB.Id},
+	}); err != nil {
+		t.Fatalf("create tgweb-only client: %v", err)
+	}
+
+	result, needRestart, err := svc.BulkSetEnable(inboundSvc, []string{email}, true)
+	if err != nil {
+		t.Fatalf("BulkSetEnable(true) (DEFECT-C regression): %v", err)
+	}
+	if needRestart {
+		t.Fatal("tgweb bulk enable must not request an Xray restart")
