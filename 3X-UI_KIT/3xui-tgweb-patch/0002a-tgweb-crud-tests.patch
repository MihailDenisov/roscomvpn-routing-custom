+// TestDetachTgWebClient covers DEFECT-B: DetachByEmail from the tgweb inbound
+// must actually remove the client_inbounds row while keeping the record and
+// every VPN attachment.
+func TestDetachTgWebClient(t *testing.T) {
+	setupBulkDB(t)
+	svc := &ClientService{}
+	inboundSvc := &InboundService{}
+	email := "d2ieytntgp-crud@x"
+	vlessIB, tgwebIB := seedTgWebCrudFixtures(t, svc, inboundSvc, email)
+
+	needRestart, err := svc.DetachByEmail(inboundSvc, tgwebIB.Id, email)
+	if err != nil {
+		t.Fatalf("DetachByEmail (DEFECT-B regression): %v", err)
+	}
+	if needRestart {
+		t.Fatal("tgweb detach must not request an Xray restart")
+	}
+
+	if n := attachmentCount(t, tgwebIB.Id, email); n != 0 {
+		t.Fatalf("tgweb relation still present (count %d)", n)
+	}
+	if n := attachmentCount(t, vlessIB.Id, email); n != 1 {
+		t.Fatalf("vless relation count = %d, want 1", n)
+	}
+	if _, err := svc.GetRecordByEmail(nil, email); err != nil {
+		t.Fatalf("ClientRecord must survive detach: %v", err)
+	}
+	rec, _ := svc.GetRecordByEmail(nil, email)
+	if !rec.Enable {
+		t.Fatal("detach must not change the global enable state")
+	}
+}
