+// TestTgWebCrudDoesNotRequestXrayRestart pins the Xray-isolation side of all
+// three fixes: on a TgWeb-ONLY client, update, detach, reattach and bulk
+// enable/disable never set needRestart, and the tgweb settings JSON stays
+// {"clients":[]} across the whole CRUD cycle.
+func TestTgWebCrudDoesNotRequestXrayRestart(t *testing.T) {
+	setupBulkDB(t)
+	svc := &ClientService{}
+	inboundSvc := &InboundService{}
+	email := "norestart-crud@x"
+	tgwebIB := seedTgWebInbound(t, 54105)
+
+	if _, err := svc.Create(inboundSvc, &ClientCreatePayload{
+		Client:     model.Client{Email: email, SubID: email + "-sub", Enable: true},
+		InboundIds: []int{tgwebIB.Id},
+	}); err != nil {
+		t.Fatalf("create tgweb-only client: %v", err)
+	}
+
+	rec, err := svc.GetRecordByEmail(nil, email)
+	if err != nil {
+		t.Fatalf("record: %v", err)
+	}
+	updated := rec.ToClient()
+	updated.Comment = "no-restart check"
+	updated.ExpiryTime = 1893456000000
+	updated.TotalGB = 32
+	nr, err := svc.Update(inboundSvc, rec.Id, *updated, 0)
+	if err != nil || nr {
+		t.Fatalf("update: err=%v needRestart=%v, want nil/false", err, nr)
+	}
+
+	if nr, err := svc.Detach(inboundSvc, rec.Id, []int{tgwebIB.Id}); err != nil || nr {
+		t.Fatalf("detach: err=%v needRestart=%v, want nil/false", err, nr)
+	}
+	if nr, err := svc.Attach(inboundSvc, rec.Id, []int{tgwebIB.Id}); err != nil || nr {
+		t.Fatalf("reattach: err=%v needRestart=%v, want nil/false", err, nr)
+	}
+	if _, nr, err := svc.BulkSetEnable(inboundSvc, []string{email}, false); err != nil || nr {
+		t.Fatalf("bulk disable: err=%v needRestart=%v, want nil/false", err, nr)
+	}
+	if _, nr, err := svc.BulkSetEnable(inboundSvc, []string{email}, true); err != nil || nr {
+		t.Fatalf("bulk enable: err=%v needRestart=%v, want nil/false", err, nr)
+	}
+	if clients := tgwebSettingsClients(t, reloadInbound(t, tgwebIB.Id)); len(clients) != 0 {
+		t.Fatalf("tgweb settings.clients = %d entries after CRUD cycle, want 0", len(clients))
+	}
+}
