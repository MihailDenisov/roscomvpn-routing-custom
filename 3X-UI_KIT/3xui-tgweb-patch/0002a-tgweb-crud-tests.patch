+// TestDetachTgWebDoesNotTouchVPNAttachments pins DEFECT-B scope: detaching
+// from tgweb leaves every VPN (vless) attachment byte-identical.
+func TestDetachTgWebDoesNotTouchVPNAttachments(t *testing.T) {
+	setupBulkDB(t)
+	svc := &ClientService{}
+	inboundSvc := &InboundService{}
+	email := "detach-scope@x"
+	vlessIB, tgwebIB := seedTgWebCrudFixtures(t, svc, inboundSvc, email)
+	before := reloadInbound(t, vlessIB.Id).Settings
+
+	if _, err := svc.DetachByEmail(inboundSvc, tgwebIB.Id, email); err != nil {
+		t.Fatalf("detach: %v", err)
+	}
+
+	if after := reloadInbound(t, vlessIB.Id).Settings; after != before {
+		t.Fatalf("vless settings changed by tgweb detach:\nbefore: %s\nafter: %s", before, after)
+	}
+	if n := attachmentCount(t, vlessIB.Id, email); n != 1 {
+		t.Fatalf("vless relation count = %d, want 1", n)
+	}
+	if got := jsonClientEnable(t, inboundSvc, vlessIB.Id, email); !got {
+		t.Fatal("vless JSON client enable flipped by tgweb detach")
+	}
+}
