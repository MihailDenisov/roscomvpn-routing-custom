+// seedTgWebCrudFixtures creates one vless inbound and one tgweb virtual
+// inbound (settings pinned to {"clients":[]}) and attaches the mixed client
+// to both through the normal add path.
+func seedTgWebCrudFixtures(t *testing.T, svc *ClientService, inboundSvc *InboundService, email string) (vlessIB, tgwebIB *model.Inbound) {
+	t.Helper()
+	vlessIB = mkInbound(t, 54101, model.VLESS, `{"clients":[]}`)
+	tgwebIB = seedTgWebInbound(t, 54102)
+
+	client := model.Client{
+		Email:  email,
+		ID:     "22222222-2222-2222-2222-222222222222",
+		SubID:  email + "-sub",
+		Enable: true,
+	}
+	if _, err := svc.AddInboundClient(inboundSvc, &model.Inbound{
+		Id:       vlessIB.Id,
+		Settings: clientsSettings(t, []model.Client{client}),
+	}); err != nil {
+		t.Fatalf("attach vless: %v", err)
+	}
+	if _, err := svc.AddInboundClient(inboundSvc, &model.Inbound{
+		Id:       tgwebIB.Id,
+		Settings: clientsSettings(t, []model.Client{client}),
+	}); err != nil {
+		t.Fatalf("attach tgweb: %v", err)
+	}
+	return vlessIB, tgwebIB
+}
+
+func seedTgWebInbound(t *testing.T, port int) *model.Inbound {
+	t.Helper()
+	in := &model.Inbound{
+		Tag:      "tgweb-crud",
+		Enable:   true,
+		Port:     port,
+		Protocol: model.TgWeb,
+		Settings: `{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`,
+	}
+	if err := database.GetDB().Create(in).Error; err != nil {
+		t.Fatalf("seed tgweb inbound: %v", err)
+	}
+	return in
+}
+
+func tgwebSettingsClients(t *testing.T, ib *model.Inbound) []any {
+	t.Helper()
+	var settings map[string]any
+	if err := json.Unmarshal([]byte(ib.Settings), &settings); err != nil {
+		t.Fatalf("tgweb settings json: %v", err)
+	}
+	clients, _ := settings["clients"].([]any)
+	return clients
+}
+
+func attachmentCount(t *testing.T, inboundId int, email string) int64 {
+	t.Helper()
+	var n int64
+	if err := database.GetDB().Model(&model.ClientInbound{}).
+		Joins("JOIN clients ON clients.id = client_inbounds.client_id").
+		Where("client_inbounds.inbound_id = ? AND clients.email = ?", inboundId, email).
+		Count(&n).Error; err != nil {
+		t.Fatalf("attachment count: %v", err)
+	}
+	return n
+}
+
+func reloadInbound(t *testing.T, id int) *model.Inbound {
+	t.Helper()
+	var ib model.Inbound
+	if err := database.GetDB().First(&ib, id).Error; err != nil {
+		t.Fatalf("reload inbound %d: %v", id, err)
+	}
+	return &ib
+}
