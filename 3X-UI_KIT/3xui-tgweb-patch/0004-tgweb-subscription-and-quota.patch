+// Each canonical reset starts a new epoch: repeated resets advance the
+// sequence monotonically instead of re-detecting the same drop.
+func TestRepeatedResetAdvancesEpochMonotonically(t *testing.T) {
+	setupConflictDB(t)
+	if err := database.GetDB().Create(&xray.ClientTraffic{Email: "bob", Up: 100, Down: 50, Enable: true}).Error; err != nil {
+		t.Fatalf("seed traffic: %v", err)
+	}
+	if err := database.GetDB().Create(&model.TgWebTrafficBaseline{Email: "bob", Domain: "web.maicraft.tech"}).Error; err != nil {
+		t.Fatalf("seed baseline: %v", err)
+	}
+
+	svc := &InboundService{}
+	for want := int64(1); want <= 2; want++ {
+		if err := svc.ResetClientTrafficByEmail("bob"); err != nil {
+			t.Fatalf("ResetClientTrafficByEmail pass %d: %v", want, err)
+		}
+		var row model.TgWebTrafficBaseline
+		if err := database.GetDB().Where("email = ?", "bob").First(&row).Error; err != nil {
+			t.Fatalf("baseline row: %v", err)
+		}
+		if row.ResetSeq != want {
+			t.Fatalf("pass %d: reset_seq = %d, want %d", want, row.ResetSeq, want)
+		}
+	}
