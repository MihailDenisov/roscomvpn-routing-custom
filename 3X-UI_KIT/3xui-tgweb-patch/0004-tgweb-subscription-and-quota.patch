+// syncEpochs pins each client's quota-epoch baseline. The canonical reset
+// fact is ResetSeq, advanced by every centralized 3x-ui traffic-reset path
+// via tgweb.MarkClientsReset — including for a client whose VPN usage is
+// 0 -> 0, where no counter drop could ever be observed. When the sequence
+// moves, the web baseline pins to the current runtime counters and the new
+// epoch starts at zero effective web usage. If the runtime entry is missing
+// at that moment, the pin defers to the next tick that sees the client.
+// Runtime counters themselves are never reset from here. A missing runtime
+// entry otherwise keeps the previous baseline — a temporarily absent client
+// must not corrupt the epoch. As a self-healing fallback for any reset path
+// not instrumented with MarkClientsReset, the VPN aggregate (including AWG
+// shadows) dropping below the last observed value also advances the epoch:
+// VPN counters are cumulative within an epoch, so a drop means a reset.
+func (j *TgWebJob) syncEpochs(desired []tgweb.DesiredDomain) error {
+	if len(desired) == 0 {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	snap, err := tgweb.GetManager().Snapshot(ctx)
+	if err != nil {
+		return err
+	}
+	counters := make(map[string]map[string]tgweb.SnapshotClient, len(snap))
+	for _, d := range snap {
+		domain := strings.ToLower(strings.TrimSpace(d.Domain))
+		m := counters[domain]
+		if m == nil {
+			m = make(map[string]tgweb.SnapshotClient, len(d.Clients))
+			counters[domain] = m
+		}
+		for _, c := range d.Clients {
+			m[c.Name] = c
+		}
+	}
+
+	db := database.GetDB()
+	for i := range desired {
+		d := &desired[i]
+		domain := strings.ToLower(strings.TrimSpace(d.Domain))
+		runtimeClients := counters[domain]
+		for k := range d.Clients {
+			dc := &d.Clients[k]
+			var row model.TgWebTrafficBaseline
+			res := db.Where("email = ? AND domain = ?", dc.Name, domain).First(&row)
+			if res.Error == nil {
+				if row.ResetSeq != row.SeenResetSeq {
+					if cur, ok := runtimeClients[dc.Name]; ok {
+						logger.Info("tgweb: quota reset recorded for", dc.Name,
+							"; advancing web quota baseline to current runtime counters")
+						row.BaselineUp = cur.BytesUp
+						row.BaselineDown = cur.BytesDown
+						row.SeenResetSeq = row.ResetSeq
+					}
+				}
+				if dc.VPNUsedBytes < row.VpnSeen {
+					if cur, ok := runtimeClients[dc.Name]; ok {
+						logger.Warning("tgweb: VPN traffic reset detected for", dc.Name,
+							"; advancing web quota baseline to current runtime counters")
+						row.BaselineUp = cur.BytesUp
+						row.BaselineDown = cur.BytesDown
+						row.SeenResetSeq = row.ResetSeq
+					}
+				}
+				row.VpnSeen = dc.VPNUsedBytes
+				if err := db.Save(&row).Error; err != nil {
+					return err
+				}
+			} else {
+				// First sighting of this (email, domain): the current epoch
+				// starts at baseline 0, so historical runtime traffic counts
+				// against the current quota, exactly like pre-reset VPN bytes.
+				row = model.TgWebTrafficBaseline{
+					Email:   dc.Name,
+					Domain:  domain,
+					VpnSeen: dc.VPNUsedBytes,
+				}
+				if err := db.Create(&row).Error; err != nil {
+					return err
+				}
+			}
+			dc.WebBaselineUp = row.BaselineUp
+			dc.WebBaselineDown = row.BaselineDown
+		}
+	}
+	return nil
+}
