+++ b/internal/sub/tgweb_test.go
@@ -0,0 +1,233 @@
+package sub
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/tgweb"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+type tgwebShareAPI struct {
+	domains []tgweb.SnapshotDomain
+	err     error
+}
+
+func (a *tgwebShareAPI) Get(_ context.Context) ([]tgweb.SnapshotDomain, error) {
+	return a.domains, a.err
+}
+
+func (a *tgwebShareAPI) Put(_ context.Context, _ string, _ []tgweb.PolicyClient) error {
+	return nil
+}
+
+func setupTgWebShareDB(t *testing.T) {
+	t.Helper()
+	if err := database.InitDB(filepath.Join(t.TempDir(), "tgweb_sub.db")); err != nil {
+		t.Fatalf("database.InitDB failed: %v", err)
+	}
+	t.Cleanup(func() { _ = database.CloseDB() })
+}
+
+func seedShareClient(t *testing.T, email, subId string, enable bool, totalGB, expiry int64) model.ClientRecord {
+	t.Helper()
+	rec := &model.ClientRecord{
+		Email:      email,
+		SubID:      subId,
+		Enable:     enable,
+		TotalGB:    totalGB,
+		ExpiryTime: expiry,
+	}
+	if err := database.GetDB().Create(rec).Error; err != nil {
+		t.Fatalf("create client: %v", err)
+	}
+	if !enable {
+		// gorm omits zero-value fields that carry a default tag on insert,
+		// so flip enable explicitly.
+		if err := database.GetDB().Model(rec).Update("enable", false).Error; err != nil {
+			t.Fatalf("disable client: %v", err)
+		}
+		rec.Enable = false
+	}
+	return *rec
+}
+
+func seedShareAttachment(t *testing.T, rec model.ClientRecord, inboundId int) {
+	t.Helper()
+	if err := database.GetDB().Create(&model.ClientInbound{ClientId: rec.Id, InboundId: inboundId}).Error; err != nil {
+		t.Fatalf("attach: %v", err)
+	}
+}
+
+func seedShareInbound(t *testing.T, id int, enable bool) {
+	t.Helper()
+	ib := &model.Inbound{
+		Id:       id,
+		Tag:      "tgweb-web",
+		Protocol: model.TgWeb,
+		Port:     0,
+		Enable:   enable,
+		Settings: `{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`,
+	}
+	if err := database.GetDB().Create(ib).Error; err != nil {
+		t.Fatalf("create inbound: %v", err)
+	}
+}
+
+func runtimeWith(email, secret string, up, down int64) []tgweb.SnapshotDomain {
+	return []tgweb.SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []tgweb.SnapshotClient{{
+			PolicyClient: tgweb.PolicyClient{Name: email, Secret: secret, Enabled: true},
+			BytesUp:      up, BytesDown: down,
+		}},
+	}}
+}
+
+func TestTgWebShareHappyPath(t *testing.T) {
+	setupTgWebShareDB(t)
+	seedShareInbound(t, 42, true)
+	rec := seedShareClient(t, "mv", "sub-1", true, 0, 0)
+	seedShareAttachment(t, rec, 42)
+	tgweb.SetManagerForTest(tgweb.NewManager(&tgwebShareAPI{
+		domains: runtimeWith("mv", "00112233445566778899aabbccddeeff", 0, 0),
+	}))
+
+	share := (&SubService{}).TgWebShareForSub("sub-1")
+	if share == nil {
+		t.Fatal("share is nil for attached, enabled client")
+	}
+	want := "https://t.me/webproxy?secret=00112233445566778899aabbccddeeff&server=web.maicraft.tech"
+	if share.Link != want {
+		t.Fatalf("link = %q, want %q", share.Link, want)
+	}
+	if share.Name != "Telegram WebProxy" || share.Domain != "web.maicraft.tech" {
+		t.Fatalf("share = %+v", share)
+	}
+}
+
+func TestTgWebShareHiddenWhenNotAttached(t *testing.T) {
+	setupTgWebShareDB(t)
+	seedShareInbound(t, 42, true)
+	seedShareClient(t, "mv", "sub-1", true, 0, 0) // no attachment
+	tgweb.SetManagerForTest(tgweb.NewManager(&tgwebShareAPI{
+		domains: runtimeWith("mv", "00112233445566778899aabbccddeeff", 0, 0),
+	}))
+
+	if share := (&SubService{}).TgWebShareForSub("sub-1"); share != nil {
+		t.Fatalf("share must be hidden without attachment: %+v", share)
+	}
+}
+
+func TestTgWebShareHiddenWhenDisabledExpiredOrDepleted(t *testing.T) {
+	cases := []struct {
+		name    string
+		enable  bool
+		totalGB int64
+		used    int64
+		expiry  int64
+	}{
+		{"disabled", false, 0, 0, 0},
+		{"expired", true, 0, 0, time.Now().Add(-time.Hour).UnixMilli()},
+		{"depleted", true, 1000, 1000, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			setupTgWebShareDB(t)
+			seedShareInbound(t, 42, true)
+			rec := seedShareClient(t, "mv", "sub-1", tc.enable, tc.totalGB, tc.expiry)
+			seedShareAttachment(t, rec, 42)
+			if tc.used > 0 {
+				if err := database.GetDB().Create(&xray.ClientTraffic{
+					Email: rec.Email, Up: tc.used,
+				}).Error; err != nil {
+					t.Fatalf("seed traffic: %v", err)
+				}
+			}
+			tgweb.SetManagerForTest(tgweb.NewManager(&tgwebShareAPI{
+				domains: runtimeWith("mv", "00112233445566778899aabbccddeeff", 0, 0),
+			}))
+			if share := (&SubService{}).TgWebShareForSub("sub-1"); share != nil {
+				t.Fatalf("share must be hidden (%s): %+v", tc.name, share)
+			}
+		})
+	}
+}
+
+func TestTgWebShareHiddenWithoutRuntimeCredential(t *testing.T) {
+	setupTgWebShareDB(t)
+	seedShareInbound(t, 42, true)
+	rec := seedShareClient(t, "mv", "sub-1", true, 0, 0)
+	seedShareAttachment(t, rec, 42)
+	// Runtime has the client but with an empty secret.
+	tgweb.SetManagerForTest(tgweb.NewManager(&tgwebShareAPI{
+		domains: runtimeWith("mv", "", 0, 0),
+	}))
+	if share := (&SubService{}).TgWebShareForSub("sub-1"); share != nil {
+		t.Fatalf("share must be hidden without credential: %+v", share)
+	}
+}
+
+func TestTgWebShareHiddenWhenRuntimeDown(t *testing.T) {
+	setupTgWebShareDB(t)
+	seedShareInbound(t, 42, true)
+	rec := seedShareClient(t, "mv", "sub-1", true, 0, 0)
+	seedShareAttachment(t, rec, 42)
+	tgweb.SetManagerForTest(tgweb.NewManager(&tgwebShareAPI{err: context.DeadlineExceeded}))
