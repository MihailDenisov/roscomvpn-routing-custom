@@ -0,0 +1,62 @@
+import { fireEvent, render, screen, within } from '@testing-library/react';
+import { describe, expect, it, vi } from 'vitest';
+
+import SubLinksTab from '@/pages/sub/SubLinksTab';
+
+const TGWEB = {
+  name: 'Telegram WebProxy',
+  link: 'https://t.me/webproxy?secret=00112233445566778899aabbccddeeff&server=web.maicraft.tech',
+  domain: 'web.maicraft.tech',
+};
+
+describe('SubLinksTab TgWeb share card', () => {
+  it('renders the card with link, Telegram button, copy and QR for an attached client', () => {
+    const onCopy = vi.fn();
+    const { container } = render(
+      <SubLinksTab
+        subUrl="https://sub.example/x"
+        subJsonUrl=""
+        subClashUrl=""
+        tgweb={TGWEB}
+        onCopy={onCopy}
+      />,
+    );
+
+    const card = screen.getByTestId('tgweb-share-card');
+    expect(card).toBeTruthy();
+    // QR must encode exactly the share link, not the subscription URL.
+    expect(card.textContent).toContain(TGWEB.link);
+    expect(card.textContent).not.toContain('https://sub.example/x');
+
+    const tgButton = container.querySelector('a[href="' + TGWEB.link + '"]');
+    expect(tgButton).toBeTruthy();
+    expect(tgButton!.getAttribute('target')).toBe('_blank');
+    expect(tgButton!.getAttribute('rel')).toContain('noopener');
+
+    fireEvent.click(within(card).getAllByLabelText('copy').slice(-1)[0]);
+    expect(onCopy).toHaveBeenCalledWith(TGWEB.link);
+
+    fireEvent.click(within(card).getAllByLabelText('QR').slice(-1)[0]);
+    expect(screen.getByText(TGWEB.link, { selector: 'textarea' })).toBeTruthy();
+  });
+
+  it('hides the card when tgweb data is absent', () => {
+    const { container } = render(
+      <SubLinksTab subUrl="https://sub.example/x" subJsonUrl="" subClashUrl="" onCopy={vi.fn()} />,
+    );
+    expect(container.querySelector('[data-testid="tgweb-share-card"]')).toBeNull();
+  });
+
+  it('hides the card when tgweb link is empty', () => {
+    const { container } = render(
+      <SubLinksTab
+        subUrl="https://sub.example/x"
+        subJsonUrl=""
+        subClashUrl=""
+        tgweb={{ ...TGWEB, link: '' }}
+        onCopy={vi.fn()}
+      />,
+    );
+    expect(container.querySelector('[data-testid="tgweb-share-card"]')).toBeNull();
+  });
+});
