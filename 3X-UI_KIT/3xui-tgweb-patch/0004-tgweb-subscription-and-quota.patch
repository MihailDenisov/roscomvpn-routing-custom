+// The centralized reset paths must record the canonical TgWeb quota reset
+// even when the client's VPN usage is 0 -> 0: a counter drop can never
+// signal that, so the fact has to be written by the reset path itself.
+func TestResetClientTrafficByEmailAdvancesTgWebEpoch(t *testing.T) {
+	setupConflictDB(t)
+	if err := database.GetDB().Create(&xray.ClientTraffic{Email: "bob", Up: 100, Down: 50, Enable: true}).Error; err != nil {
+		t.Fatalf("seed traffic: %v", err)
+	}
+	if err := database.GetDB().Create(&model.TgWebTrafficBaseline{
+		Email: "bob", Domain: "web.maicraft.tech",
+	}).Error; err != nil {
+		t.Fatalf("seed baseline: %v", err)
+	}
+
+	if err := (&InboundService{}).ResetClientTrafficByEmail("bob"); err != nil {
+		t.Fatalf("ResetClientTrafficByEmail: %v", err)
+	}
+
+	var tr xray.ClientTraffic
+	if err := database.GetDB().Where("email = ?", "bob").First(&tr).Error; err != nil {
+		t.Fatalf("traffic row: %v", err)
+	}
+	if tr.Up != 0 || tr.Down != 0 {
+		t.Fatalf("VPN counters = %d/%d, want 0/0", tr.Up, tr.Down)
+	}
+	var row model.TgWebTrafficBaseline
+	if err := database.GetDB().Where("email = ?", "bob").First(&row).Error; err != nil {
+		t.Fatalf("baseline row: %v", err)
+	}
+	if row.ResetSeq != 1 || row.SeenResetSeq != 0 {
+		t.Fatalf("epoch seqs = %d/%d, want reset_seq 1 (bumped), seen 0 (job folds it later)", row.ResetSeq, row.SeenResetSeq)
+	}
+}
+
+// BulkResetTraffic zeroes counters for many emails in one transaction; the
+// epoch bump must cover exactly those emails.
+func TestBulkResetTrafficAdvancesTgWebEpoch(t *testing.T) {
+	setupConflictDB(t)
+	for _, email := range []string{"bob", "alice"} {
+		if err := database.GetDB().Create(&xray.ClientTraffic{Email: email, Up: 10, Down: 10, Enable: true}).Error; err != nil {
+			t.Fatalf("seed traffic: %v", err)
+		}
+		if err := database.GetDB().Create(&model.TgWebTrafficBaseline{Email: email, Domain: "web.maicraft.tech"}).Error; err != nil {
+			t.Fatalf("seed baseline: %v", err)
+		}
+	}
+
+	if _, err := (&ClientService{}).BulkResetTraffic(&InboundService{}, []string{"bob", "alice"}); err != nil {
+		t.Fatalf("BulkResetTraffic: %v", err)
+	}
+	for _, email := range []string{"bob", "alice"} {
+		var row model.TgWebTrafficBaseline
+		if err := database.GetDB().Where("email = ?", email).First(&row).Error; err != nil {
+			t.Fatalf("baseline row %s: %v", email, err)
+		}
+		if row.ResetSeq != 1 {
+			t.Fatalf("%s reset_seq = %d, want 1", email, row.ResetSeq)
+		}
+	}
+}
+
+// ResetAllTraffics must advance the epoch of every known baseline row, even
+// rows whose VPN usage is already 0 -> 0: the canonical reset fact is written
+// by the reset path itself, never inferred from a counter drop.
+func TestResetAllTrafficsAdvancesTgWebEpoch(t *testing.T) {
+	setupConflictDB(t)
+	for _, email := range []string{"alice", "bob"} {
+		if err := database.GetDB().Create(&xray.ClientTraffic{Email: email, Enable: true}).Error; err != nil {
+			t.Fatalf("seed traffic: %v", err)
+		}
+		if err := database.GetDB().Create(&model.TgWebTrafficBaseline{Email: email, Domain: "web.maicraft.tech"}).Error; err != nil {
+			t.Fatalf("seed baseline: %v", err)
+		}
+	}
+
+	if _, err := (&ClientService{}).ResetAllTraffics(); err != nil {
+		t.Fatalf("ResetAllTraffics: %v", err)
+	}
+
+	for _, email := range []string{"alice", "bob"} {
+		var row model.TgWebTrafficBaseline
+		if err := database.GetDB().Where("email = ?", email).First(&row).Error; err != nil {
+			t.Fatalf("baseline row %s: %v", email, err)
+		}
+		if row.ResetSeq != 1 {
+			t.Fatalf("%s reset_seq = %d, want 1 (0 -> 0 VPN reset is still a real epoch)", email, row.ResetSeq)
+		}
+		var tr xray.ClientTraffic
+		if err := database.GetDB().Where("email = ?", email).First(&tr).Error; err != nil {
+			t.Fatalf("traffic row %s: %v", email, err)
+		}
+		if tr.Up != 0 || tr.Down != 0 {
+			t.Fatalf("%s VPN counters = %d/%d, want 0/0", email, tr.Up, tr.Down)
+		}
+	}
+}
+
+// A targeted bulk reset must bump exactly the named emails' epochs; every
+// other baseline row keeps its previous epoch.
+func TestBulkResetTrafficExactBatchLeavesOthers(t *testing.T) {
+	setupConflictDB(t)
+	for _, email := range []string{"alice", "bob"} {
+		if err := database.GetDB().Create(&xray.ClientTraffic{Email: email, Up: 10, Down: 10, Enable: true}).Error; err != nil {
+			t.Fatalf("seed traffic: %v", err)
+		}
+		if err := database.GetDB().Create(&model.TgWebTrafficBaseline{Email: email, Domain: "web.maicraft.tech"}).Error; err != nil {
+			t.Fatalf("seed baseline: %v", err)
+		}
+	}
+
+	if _, err := (&ClientService{}).BulkResetTraffic(&InboundService{}, []string{"bob"}); err != nil {
+		t.Fatalf("BulkResetTraffic: %v", err)
+	}
+
+	var alice, bob model.TgWebTrafficBaseline
+	if err := database.GetDB().Where("email = ?", "alice").First(&alice).Error; err != nil {
+		t.Fatalf("alice baseline: %v", err)
+	}
+	if err := database.GetDB().Where("email = ?", "bob").First(&bob).Error; err != nil {
+		t.Fatalf("bob baseline: %v", err)
+	}
+	if bob.ResetSeq != 1 {
+		t.Fatalf("bob reset_seq = %d, want 1", bob.ResetSeq)
+	}
+	if alice.ResetSeq != 0 {
+		t.Fatalf("alice reset_seq = %d, want 0 (untouched by bob's reset)", alice.ResetSeq)
+	}
+}
