+// tgwebDeleteAPI is an in-memory tgweb.API double recording PUT policies.
+type tgwebDeleteAPI struct {
+	mu      sync.Mutex
+	domains map[string][]tgweb.PolicyClient
+}
+
+func newTgwebDeleteAPI() *tgwebDeleteAPI {
+	return &tgwebDeleteAPI{domains: map[string][]tgweb.PolicyClient{}}
+}
+
+func (a *tgwebDeleteAPI) Get(context.Context) ([]tgweb.SnapshotDomain, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	out := make([]tgweb.SnapshotDomain, 0, len(a.domains))
+	for domain, clients := range a.domains {
+		snap := tgweb.SnapshotDomain{Domain: domain}
+		for _, c := range clients {
+			snap.Clients = append(snap.Clients, tgweb.SnapshotClient{PolicyClient: c})
+		}
+		out = append(out, snap)
+	}
+	return out, nil
+}
+
+func (a *tgwebDeleteAPI) Put(_ context.Context, domain string, clients []tgweb.PolicyClient) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.domains[strings.ToLower(strings.TrimSpace(domain))] = append([]tgweb.PolicyClient(nil), clients...)
+	return nil
+}
+
+func (a *tgwebDeleteAPI) client(domain, name string) (tgweb.PolicyClient, bool) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	for _, c := range a.domains[domain] {
+		if c.Name == name {
+			return c, true
+		}
+	}
+	return tgweb.PolicyClient{}, false
+}
+
+// TestDelInboundTgWebViaServicePath deletes a TgWeb inbound through the same
+// InboundService.DelInbound path the UI/API uses (not a raw DB delete) and
+// verifies the whole fail-closed contract:
+//  1. the TgWeb inbound row is gone;
+//  2. its attachment relations are cleared by the standard DetachInbound;
+//  3. the next reconcile leaves no usable orphan runtime credential
+//     (disabled, secret preserved for reattachment);
+//  4. the same client's normal VPN inbound and attachment are untouched;
+//  5. the delete never requests an Xray restart (TgWeb is virtual and never
+//     exists in the Xray runtime config).
+func TestDelInboundTgWebViaServicePath(t *testing.T) {
+	setupConflictDB(t)
+
+	seedInboundConflict(t, "tgweb-del", "", 0, model.TgWeb, "",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`)
+	seedInboundConflict(t, "vless-del", "", 8443, model.VLESS, "{}",
+		`{"clients":[]}`)
+	tgwebIB := loadInboundByTag(t, "tgweb-del")
+	vlessIB := loadInboundByTag(t, "vless-del")
+
+	rec := model.ClientRecord{Email: "mv", Enable: true}
+	if err := database.GetDB().Create(&rec).Error; err != nil {
+		t.Fatalf("client record: %v", err)
+	}
+	for _, ibID := range []int{vlessIB.Id, tgwebIB.Id} {
+		if err := database.GetDB().Create(&model.ClientInbound{ClientId: rec.Id, InboundId: ibID}).Error; err != nil {
+			t.Fatalf("attach client to inbound %d: %v", ibID, err)
+		}
+	}
+
+	// Runtime already holds a provisioned, enabled credential for mv.
+	api := newTgwebDeleteAPI()
+	api.domains["web.maicraft.tech"] = []tgweb.PolicyClient{{
+		Name: "mv", Secret: "00112233445566778899aabbccddeeff", Enabled: true,
+	}}
+	mgr := tgweb.NewManager(api)
+	tgweb.SetManagerForTest(mgr)
+	t.Cleanup(func() { tgweb.SetManagerForTest(nil) })
+
+	needRestart, err := (&InboundService{}).DelInbound(tgwebIB.Id)
+	if err != nil {
+		t.Fatalf("DelInbound: %v", err)
+	}
+	if needRestart {
+		t.Fatal("deleting a virtual TgWeb inbound must not request an Xray restart")
+	}
+
+	// 1. inbound row gone
+	var n int64
+	if err := database.GetDB().Model(&model.Inbound{}).
+		Where("id = ? AND protocol = ?", tgwebIB.Id, model.TgWeb).Count(&n).Error; err != nil {
+		t.Fatalf("count tgweb inbound: %v", err)
+	}
+	if n != 0 {
+		t.Fatalf("tgweb inbound %d still present", tgwebIB.Id)
+	}
+
+	// 2. attachment relations for the deleted inbound cleared
+	if err := database.GetDB().Model(&model.ClientInbound{}).
+		Where("inbound_id = ?", tgwebIB.Id).Count(&n).Error; err != nil {
+		t.Fatalf("count tgweb attachments: %v", err)
+	}
+	if n != 0 {
+		t.Fatalf("orphan client_inbounds rows for deleted tgweb inbound: %d", n)
+	}
+
+	// 4. normal VPN inbound and attachment untouched
+	if err := database.GetDB().Model(&model.Inbound{}).
+		Where("id = ?", vlessIB.Id).Count(&n).Error; err != nil {
+		t.Fatalf("count vless inbound: %v", err)
+	}
+	if n != 1 {
+		t.Fatal("normal VPN inbound must survive a TgWeb inbound delete")
+	}
+	if err := database.GetDB().Model(&model.ClientInbound{}).
+		Where("client_id = ? AND inbound_id = ?", rec.Id, vlessIB.Id).Count(&n).Error; err != nil {
+		t.Fatalf("count vless attachment: %v", err)
+	}
+	if n != 1 {
+		t.Fatal("normal VPN attachment must survive a TgWeb inbound delete")
+	}
+
+	// 3. reconcile with no remaining TgWeb desired state: fail closed,
+	//    credential disabled but secret preserved (reattach keeps it).
+	if err := mgr.Reconcile(context.Background(), nil); err != nil {
+		t.Fatalf("reconcile: %v", err)
+	}
+	pol, ok := api.client("web.maicraft.tech", "mv")
+	if !ok {
+		t.Fatal("runtime credential must be kept (disabled), not deleted")
+	}
+	if pol.Enabled {
+		t.Fatalf("orphan runtime credential must be disabled after inbound delete: %+v", pol)
+	}
+	if pol.Secret != "00112233445566778899aabbccddeeff" {
+		t.Fatalf("secret must be preserved for reattachment: %+v", pol)
+	}
+}
