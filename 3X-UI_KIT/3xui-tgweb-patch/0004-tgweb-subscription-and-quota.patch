+// TgWeb-only client: VPN usage is 0 the whole time, so no counter drop can
+// ever signal a reset. The canonical reset fact (ResetSeq, written by the
+// centralized reset paths via tgweb.MarkClientsReset) must still advance the
+// web baseline to the current runtime counters and start a clean epoch.
+func TestTgWebJobEpochCanonicalResetWithZeroVpnUsage(t *testing.T) {
+	setupTgWebJobDB(t)
+	seedTgWebInbound(t, 42, "tgweb-web",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`, true)
+	seedTgWebClient(t, "bob", 42)
+	seedTraffic(t, "bob", 0, 0)
+
+	api := &epochAPI{domains: []tgweb.SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []tgweb.SnapshotClient{{
+			PolicyClient: tgweb.PolicyClient{Name: "bob", Secret: "s3cr3t", Enabled: true},
+			BytesUp:      0, BytesDown: 400,
+		}},
+	}}}
+	tgweb.SetManagerForTest(tgweb.NewManager(api))
+
+	// Tick 1: initial epoch — historical web traffic counts, baseline stays 0.
+	NewTgWebJob().Run()
+	row, ok := baselineRow(t, "bob", "web.maicraft.tech")
+	if !ok || row.BaselineUp != 0 || row.BaselineDown != 0 || row.VpnSeen != 0 {
+		t.Fatalf("initial epoch row = %+v ok=%v, want zero baseline, vpnSeen 0", row, ok)
+	}
+
+	// Штатный reset через централизованный путь (VPN 0 -> 0, наблюдать нечего).
+	tgweb.MarkClientsReset(database.GetDB(), []string{"bob"})
+
+	// Runtime counters keep accumulating while the panel resets VPN traffic.
+	api.domains[0].Clients[0].BytesDown = 460
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "bob", "web.maicraft.tech")
+	if row.BaselineUp != 0 || row.BaselineDown != 460 {
+		t.Fatalf("post-reset row = %+v, want baseline pinned to current runtime counters 0/460", row)
+	}
+	if row.ResetSeq != 1 || row.SeenResetSeq != 1 {
+		t.Fatalf("epoch seqs = %d/%d, want 1/1", row.ResetSeq, row.SeenResetSeq)
+	}
+	// Effective web usage is now max(0, 460-460) = 0: the new period is clean.
+
+	// A tick without a reset must keep the epoch stable.
+	api.domains[0].Clients[0].BytesDown = 500
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "bob", "web.maicraft.tech")
+	if row.BaselineDown != 460 || row.ResetSeq != 1 || row.SeenResetSeq != 1 {
+		t.Fatalf("stable epoch row = %+v, want baseline 460, seqs 1/1", row)
+	}
+}
