+		{"disabled credential with exhausted shared quota and non-empty secret", 1000, 100, 900},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			setupTgWebShareDB(t)
+			seedShareInbound(t, 42, true)
+			rec := seedShareClient(t, "mv", "sub-1", true, tc.totalGB, 0)
+			seedShareAttachment(t, rec, 42)
