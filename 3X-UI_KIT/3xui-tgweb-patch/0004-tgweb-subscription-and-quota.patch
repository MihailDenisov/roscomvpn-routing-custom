+// that only the reconciler can see, and a disabled credential that still
+// carries a non-empty secret.
+func TestTgWebShareHiddenWhenRuntimeCredentialDisabled(t *testing.T) {
+	cases := []struct {
+		name    string
+		totalGB int64
+		vpnUsed int64
+		up      int64
+	}{
