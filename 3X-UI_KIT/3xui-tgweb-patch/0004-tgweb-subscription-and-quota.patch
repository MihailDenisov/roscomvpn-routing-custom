diff --git a/internal/tgweb/reset.go b/internal/tgweb/reset.go
new file mode 100644
index 00000000..a554a3f9
--- /dev/null
+++ b/internal/tgweb/reset.go
@@ -0,0 +1,52 @@
+package tgweb
+
+import (
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+
+	"gorm.io/gorm"
+)
+
+// markResetChunk bounds emails per UPDATE so the statement stays under the
+// SQLite host-variable limit and the MySQL packet limit on any real install.
+const markResetChunk = 500
+
+// MarkClientsReset records the canonical fact of a 3x-ui traffic reset for
+// the given canonical client emails: every matching baseline row's ResetSeq
+// advances by one, starting a new shared-quota epoch. An empty emails slice
+// advances every known row (ResetAllTraffics also covers clients without
+// TgWeb attachments; the epoch takes effect only for attached ones).
+//
+// It is deliberately best-effort and never returns an error: tgweb quota
+// bookkeeping must never break a core 3x-ui traffic reset, so failures are
+// logged and swallowed, and the epoch self-heals on the next TgWeb job tick.
+//
+// Call it inside the caller's traffic-write transaction so the reset and the
+// epoch bump commit atomically.
+func MarkClientsReset(tx *gorm.DB, emails []string) {
+	if tx == nil {
+		return
+	}
+	bump := func(batch []string) {
+		// Always build the statement with an explicit predicate: a batch
+		// scopes to exactly those emails, and an empty batch is a
+		// deliberate all-row update ("1 = 1"), never an accidental
+		// unscoped UPDATE that relies on ORM safety-guard behaviour.
+		q := tx.Model(&model.TgWebTrafficBaseline{})
+		if len(batch) == 0 {
+			q = q.Where("1 = 1")
+		} else {
+			q = q.Where("email IN ?", batch)
+		}
+		if err := q.Update("reset_seq", gorm.Expr("reset_seq + 1")).Error; err != nil {
+			logger.Warning("tgweb: record quota reset epoch failed:", err)
+		}
+	}
+	if len(emails) == 0 {
+		bump(nil)
+		return
+	}
+	for start := 0; start < len(emails); start += markResetChunk {
+		bump(emails[start:min(start+markResetChunk, len(emails))])
+	}
+}
diff --git a/internal/web/job/tgweb_e2e_test.go b/internal/web/job/tgweb_e2e_test.go
new file mode 100644
index 00000000..b371439d
--- /dev/null
+++ b/internal/web/job/tgweb_e2e_test.go
@@ -0,0 +1,223 @@
+package job
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/tgweb"
+)
+
+// tgwebRuntimeMock is an HTTP-level mock of tgwebproxy-multi's admin API.
+type tgwebRuntimeMock struct {
+	mu      sync.Mutex
+	domains map[string][]tgweb.PolicyClient
+	up      map[string]int64
+	down    map[string]int64
+}
+
+func newTgwebRuntimeMock() *tgwebRuntimeMock {
+	return &tgwebRuntimeMock{
+		domains: map[string][]tgweb.PolicyClient{},
+		up:      map[string]int64{},
+		down:    map[string]int64{},
+	}
+}
+
+func (m *tgwebRuntimeMock) key(domain, name string) string { return domain + "\x00" + name }
+
+func (m *tgwebRuntimeMock) handler(token string) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/clients", func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer "+token {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		switch r.Method {
+		case http.MethodGet:
+			out := make([]tgweb.SnapshotDomain, 0, len(m.domains))
+			for domain, clients := range m.domains {
+				snap := tgweb.SnapshotDomain{Domain: domain}
+				for _, c := range clients {
+					snap.Clients = append(snap.Clients, tgweb.SnapshotClient{
+						PolicyClient: c,
+						BytesUp:      m.up[m.key(domain, c.Name)],
+						BytesDown:    m.down[m.key(domain, c.Name)],
+					})
+				}
+				out = append(out, snap)
+			}
+			_ = json.NewEncoder(w).Encode(out)
+		case http.MethodPut:
+			var body struct {
+				Domain  string               `json:"domain"`
+				Clients []tgweb.PolicyClient `json:"clients"`
+			}
+			if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			m.domains[body.Domain] = append([]tgweb.PolicyClient(nil), body.Clients...)
+			w.WriteHeader(http.StatusOK)
+		default:
+			w.WriteHeader(http.StatusMethodNotAllowed)
+		}
+	})
+	return mux
+}
+
+func (m *tgwebRuntimeMock) clientPolicy(t *testing.T, domain, name string) (tgweb.PolicyClient, bool) {
+	t.Helper()
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, c := range m.domains[domain] {
+		if c.Name == name {
+			return c, true
+		}
+	}
+	return tgweb.PolicyClient{}, false
+}
+
+func (m *tgwebRuntimeMock) setCounters(domain, name string, up, down int64) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.up[m.key(domain, name)] = up
+	m.down[m.key(domain, name)] = down
+}
+
+// TestTgWebEndToEndWithMockRuntime drives the full lifecycle from п. 6 of the
+// task against an HTTP mock of tgwebproxy-multi: attach → reconcile →
+// credential → quota/epoch → disable/enable → detach/reattach (secret
+// preserved) → inbound deletion fail-closed → runtime outage tolerance.
+func TestTgWebEndToEndWithMockRuntime(t *testing.T) {
+	setupTgWebJobDB(t)
+	seedTgWebInbound(t, 42, "tgweb-web",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`, true)
+	rec := seedTgWebClient(t, "mv", 42)
+
+	const token = "test-admin-token"
+	mock := newTgwebRuntimeMock()
+	server := httptest.NewServer(mock.handler(token))
+	defer server.Close()
+
+	tokenFile := filepath.Join(t.TempDir(), "admin.token")
+	if err := os.WriteFile(tokenFile, []byte(token+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	client, err := tgweb.NewClient(server.URL, tokenFile, nil)
+	if err != nil {
+		t.Fatalf("NewClient: %v", err)
+	}
+	tgweb.SetManagerForTest(tgweb.NewManager(client))
+	t.Cleanup(func() { tgweb.SetManagerForTest(nil) })
+
+	domain := "web.maicraft.tech"
+	run := func() { NewTgWebJob().Run() }
+
+	// attach → reconcile → credential appears
+	run()
+	pol, ok := mock.clientPolicy(t, domain, "mv")
+	if !ok || pol.Secret == "" {
+		t.Fatalf("credential not provisioned: %+v ok=%v", pol, ok)
+	}
+	if !pol.Enabled {
+		t.Fatal("fresh credential must be enabled")
+	}
+	secret := pol.Secret
+
+	// traffic → quota disables
+	mock.setCounters(domain, "mv", 900, 100)
+	seedTraffic(t, "mv", 1000, 0)
+	res := database.GetDB().Model(&model.ClientRecord{}).Where("id = ?", rec.Id).
+		Update("total_gb", 1000)
+	if res.Error != nil || res.RowsAffected != 1 {
+		t.Fatalf("set quota: %v rows=%d", res.Error, res.RowsAffected)
+	}
+	run()
+	pol, _ = mock.clientPolicy(t, domain, "mv")
+	if pol.Enabled {
+		t.Fatalf("exhausted shared quota must disable the credential: %+v", pol)
+	}
+
+	// reset traffic + epoch bump → credential enabled again
+	resetClientTrafficForTest(t, "mv")
+	mock.setCounters(domain, "mv", 900, 100) // epoch pinned here on next tick
+	run()
+	pol, _ = mock.clientPolicy(t, domain, "mv")
+	if !pol.Enabled || pol.QuotaBytes != 1000 {
+		t.Fatalf("post-reset epoch must re-enable with full quota: %+v", pol)
+	}
+
+	// disable client → credential disabled; enable → back on
+	res = database.GetDB().Model(&model.ClientRecord{}).Where("id = ?", rec.Id).Update("enable", false)
+	if res.Error != nil {
+		t.Fatal(res.Error)
+	}
+	run()
+	pol, _ = mock.clientPolicy(t, domain, "mv")
+	if pol.Enabled {
+		t.Fatalf("disabled client must disable credential: %+v", pol)
+	}
+	res = database.GetDB().Model(&model.ClientRecord{}).Where("id = ?", rec.Id).Update("enable", true)
+	if res.Error != nil {
+		t.Fatal(res.Error)
+	}
+	run()
+	pol, _ = mock.clientPolicy(t, domain, "mv")
+	if !pol.Enabled {
+		t.Fatalf("re-enabled client must re-enable credential: %+v", pol)
+	}
+
+	// detach → disabled, reattach → SAME secret preserved
+	if err := database.GetDB().Where("client_id = ? AND inbound_id = ?", rec.Id, 42).
+		Delete(&model.ClientInbound{}).Error; err != nil {
+		t.Fatal(err)
+	}
+	run()
+	pol, _ = mock.clientPolicy(t, domain, "mv")
+	if pol.Enabled {
+		t.Fatalf("detached credential must be disabled: %+v", pol)
+	}
+	if err := database.GetDB().Create(&model.ClientInbound{ClientId: rec.Id, InboundId: 42}).Error; err != nil {
+		t.Fatal(err)
+	}
+	run()
+	pol, _ = mock.clientPolicy(t, domain, "mv")
+	if !pol.Enabled || pol.Secret != secret {
+		t.Fatalf("reattach must preserve the original secret: %+v", pol)
+	}
+
+	// delete TgWeb inbound → fail-closed: credential disabled, secret kept
+	if err := database.GetDB().Delete(&model.Inbound{}, 42).Error; err != nil {
+		t.Fatal(err)
+	}
+	run()
+	pol, ok = mock.clientPolicy(t, domain, "mv")
+	if !ok || pol.Enabled || pol.Secret != secret {
+		t.Fatalf("inbound deletion must fail closed keeping the secret: %+v ok=%v", pol, ok)
+	}
+
+	// runtime outage: reconcile fails without touching desired state
+	server.Close()
+	run()
+	var n int64
+	if err := database.GetDB().Model(&model.ClientInbound{}).
+		Where("client_id = ? AND inbound_id = ?", rec.Id, 42).Count(&n).Error; err != nil {
+		t.Fatal(err)
+	}
+	if n != 1 {
+		t.Fatalf("desired attachment changed during runtime outage: count=%d", n)
+	}
+	if _, err := client.Get(context.Background()); err == nil {
+		t.Fatal("expected runtime outage error")
+	}
+}
