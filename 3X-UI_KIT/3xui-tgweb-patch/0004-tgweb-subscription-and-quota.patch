+				}
+			}
+			domains := runtimeWith("mv", "00112233445566778899aabbccddeeff", tc.up, 0)
+			domains[0].Clients[0].Enabled = false
+			tgweb.SetManagerForTest(tgweb.NewManager(&tgwebShareAPI{domains: domains}))
+			if share := (&SubService{}).TgWebShareForSub("sub-1"); share != nil {
+				t.Fatalf("share must be hidden when the runtime credential is disabled: %+v", share)
+			}
+		})
+	}
+}
