+	ResetSeq     int64  `json:"resetSeq" gorm:"column:reset_seq;default:0"`
+	SeenResetSeq int64  `json:"seenResetSeq" gorm:"column:seen_reset_seq;default:0"`
+	UpdatedAt    int64  `json:"updatedAt" gorm:"autoUpdateTime:milli"`
+}
+
+func (TgWebTrafficBaseline) TableName() string { return "tgweb_traffic_baselines" }
