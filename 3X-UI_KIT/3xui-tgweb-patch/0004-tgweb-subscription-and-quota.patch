+// syncEpochs pins each client's quota-epoch baseline. A 3x-ui traffic reset
+// zeroes VPN counters; the aggregate (including AWG shadows) dropping below
+// the last observed value is the reset signal that moves the web baseline to
+// the current runtime counters. Runtime counters themselves are never reset
+// from here. A missing runtime entry keeps the previous baseline — a
+// temporarily absent client must not corrupt the epoch.
+func (j *TgWebJob) syncEpochs(desired []tgweb.DesiredDomain) error {
+	if len(desired) == 0 {
+		return nil
