diff --git a/internal/sub/tgweb.go b/internal/sub/tgweb.go
new file mode 100755
index 00000000..53fda79d
--- /dev/null
+++ b/internal/sub/tgweb.go
@@ -0,0 +1,116 @@
+package sub
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+	"github.com/mhsanaei/3x-ui/v3/internal/tgweb"
+)
+
+type tgwebSubSettings struct {
+	PublicHost string `json:"publicHost"`
+	PublicPort int    `json:"publicPort"`
+}
+
+// TgWebShare is the transient subscription-page model for a client's TgWeb
+// attachment. It is computed server-side on demand and never persisted: the
+// secret only exists inside tgwebproxy-multi and reaches the browser solely
+// through this authenticated subscription/share context.
+type TgWebShare struct {
+	Name   string `json:"name"`
+	Link   string `json:"link"`
+	Domain string `json:"domain"`
+}
+
+const tgwebShareScheme = "https://t.me/webproxy"
+
+// TgWebShareForSub builds the TgWeb share card for a subscription page, or
+// returns nil when the card must not be shown. Show conditions:
+// the client is globally enabled, attached to an enabled TgWeb inbound, not
+// expired, quota not exhausted, and the runtime credential actually exists.
+// A runtime outage hides the card (VPN links still render) and is logged
+// server-side without token or secret leakage.
+func (s *SubService) TgWebShareForSub(subId string) *TgWebShare {
+	db := database.GetDB()
+	var inbounds []model.Inbound
+	err := db.Model(model.Inbound{}).Where(`id in (
+		SELECT DISTINCT inbounds.id
+		FROM inbounds
+		JOIN client_inbounds ON client_inbounds.inbound_id = inbounds.id
+		JOIN clients ON clients.id = client_inbounds.client_id
+		WHERE inbounds.protocol = 'tgweb' AND inbounds.node_id IS NULL
+		  AND clients.sub_id = ? AND inbounds.enable = ?)`, subId, true).
+		Order("id ASC").Find(&inbounds).Error
+	if err != nil || len(inbounds) == 0 {
+		return nil
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	snap, err := tgweb.GetManager().Snapshot(ctx)
+	if err != nil {
+		logger.Warning("sub: tgweb runtime unavailable, hiding TgWeb card:", err)
+		return nil
+	}
+	byDomain := make(map[string]tgweb.SnapshotDomain, len(snap))
+	for _, d := range snap {
+		byDomain[strings.ToLower(strings.TrimSpace(d.Domain))] = d
+	}
+
+	now := time.Now().UnixMilli()
+	for i := range inbounds {
+		ib := &inbounds[i]
+		var settings tgwebSubSettings
+		if err := json.Unmarshal([]byte(ib.Settings), &settings); err != nil {
+			logger.Warning("sub: invalid tgweb inbound settings for", ib.Id, ":", err)
+			continue
+		}
+		domain := strings.ToLower(strings.TrimSpace(settings.PublicHost))
+		if domain == "" {
+			continue
+		}
+		var clients []model.ClientRecord
+		if err := db.Model(&model.ClientRecord{}).
+			Joins("JOIN client_inbounds ci ON ci.client_id = clients.id").
+			Where("ci.inbound_id = ? AND clients.sub_id = ? AND clients.enable = ?", ib.Id, subId, true).
+			Order("clients.id ASC").Find(&clients).Error; err != nil {
+			return nil
+		}
+		for _, c := range clients {
+			if c.ExpiryTime > 0 && now >= c.ExpiryTime {
+				continue
+			}
+			if c.TotalGB > 0 {
+				used, _ := s.AggregateTrafficByEmails([]string{c.Email})
+				if used.Up+used.Down >= c.TotalGB {
+					continue
+				}
+			}
+			runtimeDomain, ok := byDomain[domain]
+			if !ok {
+				continue
+			}
+			secret := ""
+			for _, rc := range runtimeDomain.Clients {
+				if rc.Name == c.Email && rc.Secret != "" {
+					secret = rc.Secret
+					break
+				}
+			}
+			if secret == "" {
+				continue
+			}
+			return &TgWebShare{
+				Name:   "Telegram WebProxy",
+				Link:   tgwebShareScheme + "?secret=" + secret + "&server=" + domain,
+				Domain: domain,
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/sub/tgweb_test.go b/internal/sub/tgweb_test.go
new file mode 100755
index 00000000..fb7f5495
