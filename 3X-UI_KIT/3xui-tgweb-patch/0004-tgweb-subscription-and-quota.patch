+	api.domains[0].Clients[0].BytesUp = 400
+	NewTgWebJob().Run()
+	row, _ := baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 400 || row.ResetSeq != 1 || row.SeenResetSeq != 1 {
+		t.Fatalf("cycle 1 row = %+v, want baseline 400, seqs 1/1", row)
+	}
+
+	// Cycle 2: usage accrues (vpn 30, web +50), then the second reset.
+	res := database.GetDB().Exec("UPDATE client_traffics SET up = 30 WHERE email = ?", "mv")
+	if res.Error != nil || res.RowsAffected == 0 {
+		t.Fatalf("grow vpn traffic: %v rows=%d", res.Error, res.RowsAffected)
+	}
+	api.domains[0].Clients[0].BytesUp = 450
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 400 || row.VpnSeen != 30 {
+		t.Fatalf("pre-reset-2 row = %+v, want baseline 400, vpnSeen 30", row)
+	}
+	resetClientTrafficForTest(t, "mv")
+	tgweb.MarkClientsReset(database.GetDB(), []string{"mv"})
+	api.domains[0].Clients[0].BytesUp = 700
+	api.domains[0].Clients[0].BytesDown = 100
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 700 || row.BaselineDown != 100 || row.VpnSeen != 0 ||
+		row.ResetSeq != 2 || row.SeenResetSeq != 2 {
+		t.Fatalf("cycle 2 row = %+v, want baseline 700/100, vpnSeen 0, seqs 2/2", row)
+	}
+}
+
+// A reset landing while the runtime entry is temporarily missing must not
+// pin the baseline to a wrong value: the pending sequence stays pending and
+// folds into the baseline on the first tick that sees the client again.
+func TestTgWebJobEpochCanonicalResetDefersPinUntilRuntimeSeen(t *testing.T) {
+	setupTgWebJobDB(t)
+	seedTgWebInbound(t, 42, "tgweb-web",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`, true)
+	seedTgWebClient(t, "mv", 42)
+	seedTraffic(t, "mv", 100, 0)
+
+	api := &epochAPI{domains: []tgweb.SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []tgweb.SnapshotClient{{
+			PolicyClient: tgweb.PolicyClient{Name: "mv", Secret: "s3cr3t", Enabled: true},
+			BytesUp:      100, BytesDown: 0,
+		}},
+	}}}
+	tgweb.SetManagerForTest(tgweb.NewManager(api))
+
+	NewTgWebJob().Run()
+	if row, _ := baselineRow(t, "mv", "web.maicraft.tech"); row.VpnSeen != 100 {
+		t.Fatalf("initial row = %+v, want vpnSeen 100", row)
+	}
+
+	// Runtime temporarily drops the client; the reset happens meanwhile.
+	api.domains[0].Clients = nil
+	resetClientTrafficForTest(t, "mv")
+	tgweb.MarkClientsReset(database.GetDB(), []string{"mv"})
+	NewTgWebJob().Run()
+	row, _ := baselineRow(t, "mv", "web.maicraft.tech")
+	if row.ResetSeq != 1 || row.SeenResetSeq != 0 || row.BaselineUp != 0 {
+		t.Fatalf("deferred row = %+v, want pending seq 1/0, baseline untouched", row)
+	}
+
+	// The client reappears with counters grown during the outage.
+	api.domains[0].Clients = []tgweb.SnapshotClient{{
+		PolicyClient: tgweb.PolicyClient{Name: "mv", Secret: "s3cr3t", Enabled: true},
+		BytesUp:      130, BytesDown: 0,
+	}}
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 130 || row.SeenResetSeq != 1 {
+		t.Fatalf("post-reappear row = %+v, want baseline 130, seen 1", row)
+	}
+}
