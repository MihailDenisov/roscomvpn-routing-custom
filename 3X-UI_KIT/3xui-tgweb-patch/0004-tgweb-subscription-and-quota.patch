+func TestTgWebJobEpochInitialThenResetCycle(t *testing.T) {
+	setupTgWebJobDB(t)
+	seedTgWebInbound(t, 42, "tgweb-web",
+		`{"publicHost":"web.maicraft.tech","publicPort":443,"clients":[]}`, true)
+	seedTgWebClient(t, "mv", 42)
+	seedTraffic(t, "mv", 100, 0)
+
+	api := &epochAPI{domains: []tgweb.SnapshotDomain{{
+		Domain: "web.maicraft.tech",
+		Clients: []tgweb.SnapshotClient{{
+			PolicyClient: tgweb.PolicyClient{Name: "mv", Secret: "s3cr3t", Enabled: true},
+			BytesUp:      50, BytesDown: 0,
+		}},
+	}}}
+	tgweb.SetManagerForTest(tgweb.NewManager(api))
+
+	// Tick 1: initial epoch, baseline must stay 0 (history counts).
+	NewTgWebJob().Run()
+	row, ok := baselineRow(t, "mv", "web.maicraft.tech")
+	if !ok {
+		t.Fatal("baseline row not created")
+	}
+	if row.BaselineUp != 0 || row.BaselineDown != 0 || row.VpnSeen != 100 {
+		t.Fatalf("initial epoch row = %+v, want baseline 0/0, vpnSeen 100", row)
+	}
+
+	// Runtime accumulates; 3x-ui resets VPN traffic to 0.
+	api.domains[0].Clients[0].BytesUp = 400
+	resetClientTrafficForTest(t, "mv")
+
+	// Tick 2: reset detected → baseline advances to current runtime counters.
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 400 || row.BaselineDown != 0 || row.VpnSeen != 0 {
+		t.Fatalf("post-reset row = %+v, want baseline 400/0, vpnSeen 0", row)
+	}
+
+	// Tick 3: 50 more web bytes in the new epoch; no reset → baseline stable.
+	api.domains[0].Clients[0].BytesUp = 450
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 400 || row.VpnSeen != 0 {
+		t.Fatalf("stable epoch row = %+v, want baseline 400, vpnSeen 0", row)
+	}
+
+	// Second reset cycle: traffic returns (visible to a job tick), then resets.
+	api.domains[0].Clients[0].BytesUp = 700
+	api.domains[0].Clients[0].BytesDown = 100
+	res := database.GetDB().Exec("UPDATE client_traffics SET up = 1000 WHERE email = ?", "mv")
+	if res.Error != nil || res.RowsAffected == 0 {
+		t.Fatalf("grow vpn traffic: %v rows=%d", res.Error, res.RowsAffected)
+	}
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.VpnSeen != 1000 || row.BaselineUp != 400 {
+		t.Fatalf("pre-second-reset row = %+v, want vpnSeen 1000, baseline still 400", row)
+	}
+	resetClientTrafficForTest(t, "mv")
+	NewTgWebJob().Run()
+	row, _ = baselineRow(t, "mv", "web.maicraft.tech")
+	if row.BaselineUp != 700 || row.BaselineDown != 100 || row.VpnSeen != 0 {
+		t.Fatalf("second cycle row = %+v, want baseline 700/100, vpnSeen 0", row)
+	}
+}
